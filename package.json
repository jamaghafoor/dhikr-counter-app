{
  "name": "TasbeehDigitalApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean-android": "yarn cache clean --all && cd android && ./gradlew clean && cd .. && echo \"\\x1b[1;36m✔ Android cache and Gradle build cleaned successfully.\\x1b[0m\"",
    "clean-ios": "yarn cache clean --all && cd ios && rm -rf ~/Library/Developer/Xcode/DerivedData && pod cache clean --all && cd .. && echo \"\\x1b[1;36m✔ iOS cache, Xcode DerivedData, and CocoaPods cache cleaned successfully.\\x1b[0m\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.88.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "TasbeehSpecs",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.tasbeehdigitalapp.reminders"
    },
    "ios": {
      "modulesProvider": {
        "NativeDhikrReminders": "RCTDhikrReminders"
      }
    }
  }
}
